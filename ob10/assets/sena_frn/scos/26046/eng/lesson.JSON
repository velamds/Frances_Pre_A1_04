ample"}, {"content": "frn1le04ob10aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "Voici des mots que vous pouvez employer pour d\u00e9crire votre quotidien.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "la pause", "type": "name"}, {"content": "une suspension de courte dur\u00e9e du travail", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Je prends la pause de quelques minutes pour boire mon caf\u00e9.", "type": "example"}, {"content": "frn1le04ob10aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "la journ\u00e9e", "type": "name"}, {"content": "l'espace de temps compris entre le lever et le coucher du soleil", "type": "definition"}, {"content": "(nom f.)", "type": "part_speech"}, {"content": "Exemple : Je suis occup\u00e9 toute la journ\u00e9e.", "type": "example"}, {"content": "frn1le04ob10aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "le petit-d\u00e9j'", "type": "name"}, {"content": "l'abr\u00e9viation de petit-d\u00e9jeuner", "type": "definition"}, {"content": "(nom m.)", "type": "part_speech"}, {"content": "Exemple : Prends-tu le petit-d\u00e9j' avec moi demain matin ?", "type": "example"}, {"content": "frn1le04ob10aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "\u00e0 loisir", "type": "name"}, {"content": "sans h\u00e2te ; en prenant son temps", "type": "definition"}, {"content": "(adverbe)", "type": "part_speech"}, {"content": "Exemple : J'aime prendre mon petit-d\u00e9j' \u00e0 loisir.", "type": "example"}, {"content": "frn1le04ob10aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "Bonne chance !", "type": "name"}, {"content": "souhaiter \u00e0 quelqu'un de r\u00e9ussir", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Exemple : Bonne chance pour ton entretien d'embauche !", "type": "example"}, {